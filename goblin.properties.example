# Configuration for TheGoblin.
# Copy this file to goblin.properties and put it in the working directory
# (/home/container). goblin.properties does NOT belong in the repo -
# it is listed in .gitignore.

# TMDb key for the show ID, year and artwork.
# Without a key everything else runs unchanged.
# Alternatively the environment variable TMDB_API_KEY; the file takes priority.
tmdb.api_key =

# SFTP target for --upload.
sftp.host = 192.168.1.50
sftp.port = 22
sftp.user = perry
sftp.key  = /home/container/.ssh/id_ed25519
sftp.base = /srv/media

# Password instead of a key, for targets that do not accept keys. The weaker
# option: it sits here in plain text, and on a Panel's built-in SFTP it is your
# panel account password rather than a credential scoped to one directory.
# It is never passed on the command line - curl reads it from stdin.
# If sftp.key is set as well, the key wins and this line is ignored.
#
# Careful: this is a Java properties file, so a backslash is an escape
# character. A password containing \ has to be written \\ here.
# sftp.password =

# SSH host key of the target, as SHA256.
# curl checks the host key against known_hosts, which a fresh container does
# not have - without this the upload fails with code 60 before transferring
# anything. Get the hash from your own machine with:
#
#   ssh-keyscan -p 22 the-host 2>/dev/null | ssh-keygen -lf -
#
# Paste the SHA256:... part; the prefix may stay, it is stripped.
# sftp.hostkey_sha256 =

# Or skip the host key check entirely. Then anything answering on that
# host and port is trusted. Only sensible on a network you control, and
# the hash above is the better answer. Ignored when the hash is set.
# sftp.insecure = false
